{
  "name": "downboss-root",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "node dev.js",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "cd backend && python -m uvicorn main:app --host 127.0.0.1 --port 8000 --reload",
    "install:frontend": "npm --prefix frontend install",
    "build": "npm run build --prefix frontend",
    "start": "npm run start --prefix frontend"
  }
}
