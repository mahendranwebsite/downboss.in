# Frontend Environment Variables (for Vercel or local frontend/.env.local)
NEXT_PUBLIC_API_URL=https://api.downboss.in
BACKEND_API_URL=https://api.downboss.in

# Optional Google AdSense Publisher ID
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX

# Backend Environment Variables (backend/.env)
PORT=8000
HOST=0.0.0.0
# Optional proxy or cookies for yt-dlp if needed on strict cloud providers
# HTTP_PROXY=http://user:pass@proxy.example.com:8080
# YT_DLP_COOKIES_PATH=cookies.txt
